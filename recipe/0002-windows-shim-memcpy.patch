+/// `memcpy`/`memset` normally come from `compiler_builtins`' `mem` feature,
+/// which is only enabled by `-Zbuild-std-features=compiler-builtins-mem`.
+/// This build has no `-Zbuild-std` (defaults does not ship rust-src) and the
+/// shim links with `/NODEFAULTLIB`, so provide them here. The signatures must
+/// match the C ones exactly or rustc's suspicious-runtime-symbol-definitions
+/// lint fires; volatile accesses keep LLVM from re-recognising the copy idiom
+/// and recursing into memcpy.
+#[cfg(windows)]
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn memcpy(
+    dest: *mut core::ffi::c_void,
+    src: *const core::ffi::c_void,
+    count: usize,
+) -> *mut core::ffi::c_void {
+    unsafe {
+        let d = dest as *mut u8;
+        let s = src as *const u8;
+        let mut i = 0usize;
+        while i < count {
+            core::ptr::write_volatile(d.add(i), core::ptr::read_volatile(s.add(i)));
+            i += 1;
+        }
+        dest
+    }
+}
+
+#[cfg(windows)]
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn memset(
+    dest: *mut core::ffi::c_void,
+    value: i32,
+    count: usize,
+) -> *mut core::ffi::c_void {
+    unsafe {
+        let d = dest as *mut u8;
+        let mut i = 0usize;
+        while i < count {
+            core::ptr::write_volatile(d.add(i), value as u8);
+            i += 1;
+        }
+        dest
+    }
+}
+
