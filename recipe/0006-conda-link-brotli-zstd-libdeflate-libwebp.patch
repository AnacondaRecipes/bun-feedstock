--- a/scripts/build/deps/conda-system.ts
+++ b/scripts/build/deps/conda-system.ts
@@ -0,0 +1,42 @@
+/**
+ * conda: link a dependency from the conda host prefix instead of building the
+ * vendored copy. The prefix (CONDA_SYSTEM_DEPS_PREFIX: $PREFIX, or
+ * %LIBRARY_PREFIX% on Windows) is the dep's "local" source dir, so
+ * `includes`/`libs` are relative to it. `identity` (CONDA_SYSTEM_DEP_VERSION_*)
+ * feeds bun_dependency_versions.h, which process.versions reads.
+ */
+
+import type { Config } from "../config.ts";
+import type { Dependency } from "../source.ts";
+
+function prefix(): string {
+  const p = process.env.CONDA_SYSTEM_DEPS_PREFIX;
+  if (!p) throw new Error("CONDA_SYSTEM_DEPS_PREFIX must point at the conda host prefix");
+  return p;
+}
+
+/** Shared library: lib<name>.so / lib<name>.dylib, or the <win>.lib import library. */
+export function sharedLib(cfg: Config, name: string, win: string): string {
+  if (cfg.windows) return `lib/${win}.lib`;
+  return cfg.darwin ? `lib/lib${name}.dylib` : `lib/lib${name}.so`;
+}
+
+export function condaSystemDep(opts: {
+  name: string;
+  versionMacro?: string;
+  libs: (cfg: Config) => string[];
+}): Dependency {
+  const key = opts.name.toUpperCase().replace(/[^A-Z0-9]/g, "_");
+  return {
+    name: opts.name,
+    versionMacro: opts.versionMacro,
+    source: () => ({
+      kind: "local",
+      path: prefix(),
+      identity: process.env[`CONDA_SYSTEM_DEP_VERSION_${key}`] ?? "conda",
+      hint: "CONDA_SYSTEM_DEPS_PREFIX does not exist",
+    }),
+    build: () => ({ kind: "none" }),
+    provides: cfg => ({ libs: opts.libs(cfg), includes: ["include"] }),
+  };
+}
